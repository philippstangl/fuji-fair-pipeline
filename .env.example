# `pipeline/common.py:load_dotenv()` reads `.env` (or $ENV_FILE) at config load.
# config.yaml refers to these by NAME (`api_key_env: NFDI4CAT_DATAVERSE_API_KEY`),
# so no secret is ever committed.

# Dataverse
NFDI4CAT_DATAVERSE_API_KEY=

# Zenodo
# Raises the records-per-page cap from 25 to 100.
# ZENODO_API_TOKEN=

# F-UJI
# The stock image defaults are marvel/wonderwoman.
# FUJI_USERNAME=
# FUJI_PASSWORD=
